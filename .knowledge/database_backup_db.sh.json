{"is_source_file": true, "format": "bash", "description": "A shell script that detects the running database type (SQLite, PostgreSQL, MySQL, MongoDB) and performs backups accordingly. It includes logic for different database systems, checks their availability, and executes corresponding backup commands.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "sudo -u postgres pg_isready", "mongosh", "mysqladmin", "mysql", "mysqldump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres pg_isready", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet", "echo", "exit"], "search-terms": ["backup_db.sh", "database backup", "MySQL", "PostgreSQL", "SQLite", "MongoDB", "shell script", "database detection"], "state": 2, "file_id": 2, "knowledge_revision": 11, "git_revision": "12acc39fb657f89091fa41e51577e872a63833a1", "hash": "d7da372b768c895a33088027314656c3", "format-version": 4, "code-base-name": "database", "filename": "database/backup_db.sh", "revision_history": [{"11": "12acc39fb657f89091fa41e51577e872a63833a1"}]}